# Shared (agent + relay use the same value)
RELAY_SECRET=           # Required — shared secret for agent↔relay auth

# Agent only
RELAY_URL=wss://localhost:9001/api/agent-ws              # Agent: baked at build time, runtime override. Relay: not used.
WORKSPACE_ROOT=         # Optional — default workspace path
LOCAL_PORT=9000         # Optional — agent admin UI port
CONTACT_EMAIL=          # Optional — shows a "Request via email" button next to the Relay Secret field in the agent's local admin UI
CONTACT_URL=            # Optional — shows an "Open landing page" button next to it too

# Relay only
ADMIN_PASSWORD=         # Required — admin dashboard password (blocked if not set)
ALLOWED_ORIGINS=        # Optional — comma-separated CORS origins (default: allow all in dev, none in prod)
PORT=9001               # Optional — relay server port
NEXT_PUBLIC_CONTACT_EMAIL=  # Optional — baked at build time; shows a "contact X to get access" hint on the login form
