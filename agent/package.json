{
  "name": "opencode-agent",
  "version": "0.3.0",
  "type": "module",
  "description": "OpenCode — access your dev environment from anywhere",
  "bin": {
    "opencode": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "ui/"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:cli": "tsx src/cli.ts",
    "build": "tsc",
    "prepublishOnly": "tsc",
    "start": "node dist/index.js",
    "generate-secret": "tsx src/utils/generateSecret.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": ["vscode", "remote", "agent", "ide", "editor", "terminal"],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "chokidar": "^4.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "node-pty": "^1.0.0",
    "uuid": "^10.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
